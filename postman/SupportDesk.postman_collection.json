{
  "info": {
    "name": "SupportDesk API",
    "description": "MERN helpdesk & real-time ticket management.\n\nSetup (there is no demo data):\n1. Set the `baseUrl` collection variable (default http://localhost:5050/api).\n2. Set `adminEmail` / `adminPassword` to the values in server/.env (the account made by `npm run create-admin`).\n3. Run **Auth > Register (customer)** - creates the customer from `customerEmail` / `customerPassword`.\n4. Run **Auth > Login (admin)**, then **Users > Create agent account** - creates the agent from `agentEmail` / `agentPassword`.\n5. Run the customer and agent logins. Tokens are stored automatically in `adminToken`, `customerToken` and `agentToken`.\n\nEvery response uses the envelope { success, message, data } or { success, message, errorCode }.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5050/api" },
    { "key": "adminToken", "value": "" },
    { "key": "agentToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "adminEmail", "value": "<ADMIN_EMAIL from server/.env>" },
    { "key": "adminPassword", "value": "<ADMIN_PASSWORD from server/.env>" },
    { "key": "customerEmail", "value": "customer.postman@test.local" },
    { "key": "customerPassword", "value": "Customer@12345" },
    { "key": "agentEmail", "value": "agent.postman@test.local" },
    { "key": "agentPassword", "value": "Agent@12345" },
    { "key": "ticketId", "value": "" },
    { "key": "agentId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "photoPath", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"confirmPassword\": \"{{customerPassword}}\"\n}"
            },
            "description": "Always creates a CUSTOMER. Sending a `role` field is rejected with 400."
          }
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "if (body.data?.token) {",
                  "  pm.collectionVariables.set('adminToken', body.data.token);",
                  "  pm.collectionVariables.set('userId', body.data.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login (agent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.token) {",
                  "  pm.collectionVariables.set('agentToken', body.data.token);",
                  "  pm.collectionVariables.set('agentId', body.data.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{agentEmail}}\",\n  \"password\": \"{{agentPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.token) pm.collectionVariables.set('customerToken', body.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login - wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPass@123\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Me - no token (expect 401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Customer Updated\"\n}" }
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/password", "host": ["{{baseUrl}}"], "path": ["auth", "password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{customerPassword}}\",\n  \"newPassword\": \"Customer@67890\",\n  \"confirmPassword\": \"Customer@67890\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create ticket (auto-assigned)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "if (body.data?.ticket?._id) pm.collectionVariables.set('ticketId', body.data.ticket._id);",
                  "console.log(body.data.assigned ? 'assigned to ' + body.data.agent.name : 'queued - no agent available');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets", "host": ["{{baseUrl}}"], "path": ["tickets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Payment deducted but order failed\",\n  \"description\": \"I paid via UPI and the money left my account, but the order page shows payment failed. Transaction ID 4429183771.\",\n  \"category\": \"Payment\",\n  \"priority\": \"HIGH\"\n}"
            },
            "description": "The assignment engine runs synchronously: the response tells you whether an agent was found, and who."
          }
        },
        {
          "name": "Create ticket - invalid (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets", "host": ["{{baseUrl}}"], "path": ["tickets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Hi\",\n  \"description\": \"too short\",\n  \"category\": \"Nonsense\"\n}"
            }
          }
        },
        {
          "name": "List my tickets (customer scope)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/tickets?page=1&limit=10&sort=updated",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "updated" },
                { "key": "search", "value": "payment", "disabled": true },
                { "key": "status", "value": "IN_PROGRESS", "disabled": true },
                { "key": "priority", "value": "HIGH", "disabled": true },
                { "key": "category", "value": "Payment", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List my queue (agent scope)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets?limit=20", "host": ["{{baseUrl}}"], "path": ["tickets"], "query": [{ "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "List all tickets (admin scope)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/tickets?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "unassigned", "value": "true", "disabled": true },
                { "key": "agentId", "value": "{{agentId}}", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Ticket metadata",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/meta", "host": ["{{baseUrl}}"], "path": ["tickets", "meta"] }
          }
        },
        {
          "name": "Get ticket",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}"] },
            "description": "Returns `allowedStatuses` - the transitions this caller may perform right now."
          }
        },
        {
          "name": "Assignment history (agent/admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/history", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "history"] }
          }
        },
        {
          "name": "Status: ASSIGNED -> IN_PROGRESS (agent)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/status", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}" }
          }
        },
        {
          "name": "Status: IN_PROGRESS -> RESOLVED (agent)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/status", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"RESOLVED\",\n  \"note\": \"Refund initiated, reference RFD-77120\"\n}" }
          }
        },
        {
          "name": "Status: RESOLVED -> CLOSED (customer)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/status", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CLOSED\"\n}" }
          }
        },
        {
          "name": "Status: invalid transition (expect 400)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/status", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"RESOLVED\"\n}" },
            "description": "A customer may never mark a ticket resolved -> 400 INVALID_STATUS_TRANSITION."
          }
        },
        {
          "name": "Change priority (agent/admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/priority", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "priority"] },
            "body": { "mode": "raw", "raw": "{\n  \"priority\": \"URGENT\"\n}" }
          }
        },
        {
          "name": "Reassign (admin override)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/reassign", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "reassign"] },
            "body": { "mode": "raw", "raw": "{\n  \"agentId\": \"{{agentId}}\",\n  \"note\": \"Moving to the payments specialist\"\n}" },
            "description": "Omit `agentId` (or send null) to re-run the automatic engine instead of naming an agent."
          }
        },
        {
          "name": "Reassign as agent (expect 403)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/reassign", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "reassign"] },
            "body": { "mode": "raw", "raw": "{\n  \"agentId\": \"{{agentId}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "List messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/messages?limit=100&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "messages"],
              "query": [
                { "key": "limit", "value": "100" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Send message (customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/messages", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "messages"] },
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Any update on this? The transaction ID is 4429183771.\"\n}" },
            "description": "Same service as the Socket.IO handler - persisted, then broadcast to the ticket room."
          }
        },
        {
          "name": "Send message (agent)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/messages", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "messages"] },
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Hi, I have found the transaction and raised it with our payments team.\"\n}" }
          }
        },
        {
          "name": "Send empty message (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/messages", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "messages"] },
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"   \"\n}" }
          }
        },
        {
          "name": "Send photo (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('photo sent', () => pm.response.to.have.status(201));",
                  "const url = body.data?.message?.attachments?.[0]?.url;",
                  "if (url) pm.collectionVariables.set('photoPath', url.replace(/^\\/api/, ''));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/messages/photo", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "messages", "photo"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": [], "description": "Pick a JPG, PNG, GIF or WebP up to 5 MB" },
                { "key": "content", "value": "Screenshot of the error", "type": "text" }
              ]
            },
            "description": "multipart/form-data. Select a file for `image` before sending. The file type is verified from its bytes, so a renamed non-image is rejected with 400."
          }
        },
        {
          "name": "Download photo (agent)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": { "raw": "{{baseUrl}}{{photoPath}}", "host": ["{{baseUrl}}{{photoPath}}"] },
            "description": "Run 'Send photo' first. Only the ticket's customer, its agent or an admin can download; anyone else gets 403."
          }
        },
        {
          "name": "Mark conversation read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/messages/read", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "messages", "read"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "role", "value": "agent", "disabled": true },
                { "key": "search", "value": "agent", "disabled": true },
                { "key": "isActive", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List users as customer (expect 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Create agent account (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/users/agents", "host": ["{{baseUrl}}"], "path": ["users", "agents"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Agent\",\n  \"email\": \"{{agentEmail}}\",\n  \"password\": \"{{agentPassword}}\",\n  \"skills\": [\"Payment\", \"Refund\"]\n}"
            }
          }
        },
        {
          "name": "Agent roster with workload",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/agents", "host": ["{{baseUrl}}"], "path": ["users", "agents"] }
          }
        },
        {
          "name": "Agent workload report (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/agents/workload", "host": ["{{baseUrl}}"], "path": ["users", "agents", "workload"] }
          }
        },
        {
          "name": "Set availability -> available (drains queue)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/users/{{agentId}}/availability", "host": ["{{baseUrl}}"], "path": ["users", "{{agentId}}", "availability"] },
            "body": { "mode": "raw", "raw": "{\n  \"availabilityStatus\": \"available\"\n}" },
            "description": "The response message reports how many queued tickets were picked up."
          }
        },
        {
          "name": "Set availability -> busy",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/users/{{agentId}}/availability", "host": ["{{baseUrl}}"], "path": ["users", "{{agentId}}", "availability"] },
            "body": { "mode": "raw", "raw": "{\n  \"availabilityStatus\": \"busy\"\n}" }
          }
        },
        {
          "name": "Change role (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}/role", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}", "role"] },
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"agent\"\n}" }
          }
        },
        {
          "name": "Deactivate account (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}/active", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}", "active"] },
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const first = body.data?.notifications?.[0];",
                  "if (first) pm.collectionVariables.set('notificationId', first._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "isRead", "value": "false", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Mark one read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications/{{notificationId}}/read", "host": ["{{baseUrl}}"], "path": ["notifications", "{{notificationId}}", "read"] }
          }
        },
        {
          "name": "Mark all read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications/read-all", "host": ["{{baseUrl}}"], "path": ["notifications", "read-all"] }
          }
        }
      ]
    },
    {
