# ---------------------------------------------------------------------------
# SupportDesk - backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
# Note: on Windows, port 5000 is often inside a reserved range and will fail
# with EACCES. Check with: netsh interface ipv4 show excludedportrange protocol=tcp
PORT=5050
NODE_ENV=development

# MongoDB connection string (Atlas or local)
# Example Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supportdesk?retryWrites=true&w=majority
# Example local: mongodb://127.0.0.1:27017/supportdesk
MONGO_URI=<PASTE_YOUR_MONGODB_URI_HERE>

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS / client origin (comma separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Assignment engine
# 0 = unlimited active tickets per agent. Set > 0 to cap auto-assignment.
AGENT_MAX_ACTIVE_TICKETS=0
# Prefer agents whose `skills` include the ticket category (spec §18).
# Off by default: the MVP rule is plain "least loaded available agent".
ENABLE_SKILL_BASED_ROUTING=false

# Chat photos. Leave empty to store them in server/uploads.
# In production or local cloud testing, fill in Cloudinary credentials.
UPLOADS_DIR=
CLOUDINARY_CLOUD_NAME=nuitjcee
CLOUDINARY_API_KEY=191831562758437
CLOUDINARY_API_SECRET=urXKewgUITrKZ2Bsym7ogIm6mo4

# First admin account, created with `npm run create-admin`.
# There is no demo data: customers sign up themselves and the admin adds agents.
# Password needs 8+ characters with a letter and a number.
ADMIN_NAME=Administrator
ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
ADMIN_PASSWORD=<CHOOSE_A_STRONG_PASSWORD>
