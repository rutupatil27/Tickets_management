# ---------------------------------------------------------------------------
# SupportDesk - frontend environment variables
# Copy this file to `.env`. Only VITE_* variables reach the browser bundle,
# so never put a secret in here.
# ---------------------------------------------------------------------------

# Backend origin (WITHOUT the /api suffix - appConfig adds it).
VITE_API_URL=http://localhost:5050

# Socket.IO origin. Usually identical to VITE_API_URL.
VITE_SOCKET_URL=http://localhost:5050
